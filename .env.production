# Production Environment Variables for Notulen
# Copy this file and configure for your production deployment

# ======================
# Whisper Configuration
# ======================
WHISPER_MODEL=turbo

# ======================
# LLM Provider Configuration
# ======================
# Options: openrouter, openai, anthropic
# RECOMMENDED: openrouter (30x cheaper, excellent Indonesian support)
LLM_PROVIDER=openrouter

# ======================
# OpenRouter (RECOMMENDED)
# ======================
# Get your API key from https://openrouter.ai/keys
# Free tier available, pay-as-you-go pricing
# Cost: ~$0.02-0.05 per 1-hour meeting (vs $0.60-1.50 with OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1-0528-qwen3-8b:free

# Other recommended models:
# - deepseek/deepseek-r1-0528-qwen3-8b:free (default, free, excellent Indonesian)
# - deepseek/deepseek-chat (cheap, excellent Indonesian)
# - meta-llama/llama-3.3-70b-instruct (high quality)
# - qwen/qwen-2.5-72b-instruct (excellent for Indonesian)
# - google/gemini-2.0-flash-exp:free (free tier)

# ======================
# OpenAI (Fallback)
# ======================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# ======================
# Anthropic (Fallback)
# ======================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ======================
# Database
# ======================
# For SQLite (default)
DATABASE_PATH=/app/data/notulen.db

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/notulen

# ======================
# Server Configuration
# ======================
PORT=8000
HOST=0.0.0.0

# ======================
# Frontend Configuration
# ======================
# Update this to your production domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ======================
# Optional: Monitoring & Logging
# ======================
# LOG_LEVEL=INFO
# SENTRY_DSN=your_sentry_dsn_here

# ======================
# Optional: Security
# ======================
# SECRET_KEY=your_random_secret_key_here
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
