# Whisper Model Configuration
# Options: tiny, base, small, medium, large, turbo (recommended)
WHISPER_MODEL=turbo

# LLM Provider Configuration
# Options: openai, anthropic, openrouter
LLM_PROVIDER=openrouter

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter Configuration (if using OpenRouter - RECOMMENDED for budget)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Popular free/cheap models for Indonesian:
# - deepseek/deepseek-r1-0528-qwen3-8b:free (default - free, great for Indonesian)
# - deepseek/deepseek-chat (cheap, excellent Indonesian)
# - meta-llama/llama-3.3-70b-instruct (excellent quality)
# - qwen/qwen-2.5-72b-instruct (very good for Indonesian)
# - google/gemini-2.0-flash-exp:free (free)
# See all models: https://openrouter.ai/models
OPENROUTER_MODEL=deepseek/deepseek-r1-0528-qwen3-8b:free

# Database
DATABASE_PATH=data/notulen.db

# Server
PORT=8000
HOST=0.0.0.0
